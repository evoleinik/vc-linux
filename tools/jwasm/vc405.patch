+/* TASM places USES on its own line with comma-separated registers. */
+ret_code TasmUses( struct asm_tok tokenarray[] )
+{
+    int i, count = 0;
+    uint_16 *registers;
+    if ( !CurrProc || !( ProcStatus & PRST_PROLOGUE_NOT_DONE ) )
+        return( EmitError( PROC_MACRO_MUST_PRECEDE_LOCAL ) );
+    if ( Parse_Pass != PASS_1 ) return( NOT_ERROR );
+    for ( i = 1; i < Token_Count; i += 2 ) {
+        if ( tokenarray[i].token != T_REG || SizeFromRegister( tokenarray[i].tokval ) != 2 ||
+             ( tokenarray[i+1].token != T_COMMA && tokenarray[i+1].token != T_FINAL ) )
+            return( EmitErr( SYNTAX_ERROR_EX, tokenarray[i].string_ptr ) );
+        count++;
+    }
+    if ( !count || CurrProc->e.procinfo->regslist ) return( ERROR );
+    registers = LclAlloc( ( count + 1 ) * sizeof( uint_16 ) );
+    CurrProc->e.procinfo->regslist = registers;
+    *registers++ = count;
+    for ( i = 1; i < Token_Count; i += 2 ) *registers++ = tokenarray[i].tokval;
+    LstWriteSrcLine();
+    return( NOT_ERROR );
+}
